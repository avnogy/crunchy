REDIS_PORT=6379
JOBS_POLL_INTERVAL_MS=3000
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
FFMPEG_FLAGS=
APP_UID=1000
APP_GID=1000
CRUNCHY_IMAGE=ghcr.io/avnogy/crunchy:latest
